{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kendo-farm-test",
  "main": "./tests/fixtures/test-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kendo-farm-test",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://supabase.test.invalid",
    "SUPABASE_ANON_KEY": "test-anon-key",
    "ADMIN_EMAILS": "admin-one@kendo.test,admin-two@kendo.test",
    "LINE_DEFAULT_ID": "kendo-test"
  }
}
